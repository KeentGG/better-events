# Postgres connection string (Neon, Supabase or local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/masskara

# Shared secret that signs in to mission control and the curator inbox as "Admin".
# Staff should use their own token (npm run staff:add) so their actions are attributed.
# Generate one with: openssl rand -base64 32
ADMIN_TOKEN=change-me

# Local API port for `npm run dev:api` (default 8787)
PORT=8787

# The local API runs the ingest pass (weather + classifier) every 15 minutes.
# Set to "off" when a cron or another server runs it instead.
INGEST_TIMER=

# Optional LLM classification for low-confidence posts. Off when empty.
LLM_API_KEY=

# Cloudflare Turnstile secret for crowd reports. Leave empty to skip the bot check locally.
TURNSTILE_SECRET=

# Cloudflare Turnstile site key (public), for the Contribute page. Set it together with TURNSTILE_SECRET:
# with only the secret set, every suggestion is refused.
VITE_TURNSTILE_SITE_KEY=
